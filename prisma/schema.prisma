generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RiskBand {
  A
  B
  C
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  quotes       Quote[]
}

model Quote {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  address               String
  monthlyConsumptionKwh Int
  systemSizeKw          Decimal  @db.Decimal(10,2)
  downPayment           Decimal  @db.Decimal(10,2)
  systemPrice           Decimal  @db.Decimal(12,2)
  riskBand              RiskBand
  offers                Json
  createdAt             DateTime @default(now())
}
