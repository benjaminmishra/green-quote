generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RiskBand {
  A
  B
  C
}

model Users {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  quotes       Quotes[]

  @@index([fullName])
}

model RiskBands {
  band   RiskBand @id
  apr    Decimal  @db.Decimal(5, 2)
  quotes Quotes[]
}

model LoanTerms {
  id        String  @id @default(cuid())
  termYears Int     @unique
  active    Boolean @default(true)
}

model Quotes {
  id                    String    @id @default(cuid())
  userId                String
  user                  Users     @relation(fields: [userId], references: [id])
  address               String
  monthlyConsumptionKwh Int
  systemSizeKw          Decimal   @db.Decimal(10, 2)
  downPayment           Decimal   @db.Decimal(10, 2)
  systemPrice           Decimal   @db.Decimal(12, 2)
  riskBand              RiskBand
  riskBandRef           RiskBands @relation(fields: [riskBand], references: [band])
  offers                Json
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}
